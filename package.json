{
  "name": "@trenlok/vscode-toolbox-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:public": "nuxt dev --public",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "pnpm run hooks:install",
    "typecheck": "nuxt typecheck",
    "lint": "pnpm run lint:scripts && pnpm run lint:styles",
    "lint:styles": "stylelint \"**/*.{css,scss,vue}\" --cache --allow-empty-input",
    "lint:scripts": "eslint . --cache",
    "format": "pnpm run format:scripts && pnpm run format:styles",
    "format:scripts": "eslint . --cache --fix",
    "format:styles": "stylelint \"**/*.{css,scss,vue}\" --cache --allow-empty-input --fix",
    "hooks:install": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "0.14.0",
    "@nuxtjs/sitemap": "8.5.1",
    "@rhapsodic/eslint-config": "^1.0.5",
    "@rhapsodic/stylelint-config": "^1.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.0",
    "globals": "^17.12.0",
    "lint-staged": "^17.5.1",
    "nuxt": "^4.5.2",
    "postcss-html": "^1.8.1",
    "postcss-media-minmax": "^5.0.0",
    "postcss-scss": "^4.0.9",
    "sass-embedded": "^1.104.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.15.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit",
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm exec nuxt typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,vue}": "stylelint --allow-empty-input --cache --fix"
  },
  "dependencies": {
    "@rhapsodic/bem-classnames-vue": "2.1.0"
  },
  "packageManager": "pnpm@12.4.2+sha512.08adc6613180275c7c9edada39dcf08c9c61ad4e7eaf330a4f3461f102b0f907423454d117f98e72d47fef0616070644d7bffc973a6a57f5090a6d7c368b07c9"
}
