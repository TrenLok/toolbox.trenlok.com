{
  "name": "@trenlok/vscode-toolbox-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:public": "nuxt dev --public",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "prepare": "pnpm run hooks:install",
    "typecheck": "nuxt typecheck",
    "lint": "pnpm run lint:scripts && pnpm run lint:styles",
    "lint:styles": "stylelint \"**/*.{css,scss,vue}\" --cache --allow-empty-input",
    "lint:scripts": "eslint . --cache",
    "format": "pnpm run format:scripts && pnpm run format:styles",
    "format:scripts": "eslint . --cache --fix",
    "format:styles": "stylelint \"**/*.{css,scss,vue}\" --cache --allow-empty-input --fix",
    "hooks:install": "pnpm exec simple-git-hooks"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/fonts": "1.2.0",
    "@nuxtjs/sitemap": "9.1.0",
    "@rhapsodic/eslint-config": "^7.0.0",
    "@rhapsodic/stylelint-config": "^2.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vuejs-accessibility": "^2.6.3",
    "globals": "^17.14.0",
    "lint-staged": "^17.6.0",
    "nuxt": "^4.6.4",
    "postcss-html": "^2.0.0",
    "postcss-media-minmax": "^5.0.0",
    "postcss-scss": "^4.0.9",
    "sass-embedded": "^1.107.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "vue": "latest",
    "vue-router": "latest",
    "vue-tsc": "^3.3.14"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit",
    "pre-commit": "pnpm exec lint-staged",
    "pre-push": "pnpm exec nuxt typecheck"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --cache --fix",
    "*.{css,scss,vue}": "stylelint --allow-empty-input --cache --fix"
  },
  "dependencies": {
    "@rhapsodic/bem-classnames-vue": "2.1.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
